# NexLang 2.0 - Demo Program

name = ask("Enter your name: ")

show("Hello,", name)
show("Welcome to NexLang!")

# Custom keyword: repeat
repeat 3:
    show("I am learning NexLang!")

# Custom keyword: when and otherwise
age = roll(18, 25)

show("Your generated age is:", age)

when age >= 18:
    show("You are an adult.")
otherwise:
    show("You are under 18.")

# Custom keyword: unless
unless name == "":
    show("Thanks for using NexLang!")

# New function: inside
when inside(age, 18, 30):
    show("Your age is within the range.")